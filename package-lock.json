{
  "name": "html-report",
  "version": "0.0.0-beta.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "html-report",
      "version": "0.0.0-beta.1",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "bin": {
        "html-report": "packages/core/scripts/harness.mjs",
        "html-report-build": "packages/core/scripts/build-report.mjs",
        "html-report-install": "packages/studio/scripts/install-pwa.mjs",
        "html-report-publish": "packages/core/scripts/publish-report.mjs",
        "html-report-pwa": "packages/core/scripts/generate-pwa.mjs",
        "html-report-scaffold": "packages/studio/scripts/scaffold-project.mjs",
        "html-report-serve": "packages/studio/scripts/server.mjs"
      },
      "engines": {
        "node": ">=18.0.0"
      }
    },
    "node_modules/@html-report/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@html-report/studio": {
      "resolved": "packages/studio",
      "link": true
    },
    "packages/core": {
      "name": "@html-report/core",
      "version": "0.0.0-beta.1",
      "license": "MIT",
      "bin": {
        "html-report": "scripts/harness.mjs",
        "html-report-build": "scripts/build-report.mjs",
        "html-report-publish": "scripts/publish-report.mjs",
        "html-report-pwa": "scripts/generate-pwa.mjs",
        "html-report-verify": "playwright/verify-report.mjs"
      },
      "engines": {
        "node": ">=18.0.0"
      }
    },
    "packages/studio": {
      "name": "@html-report/studio",
      "version": "0.0.0-beta.1",
      "license": "MIT",
      "dependencies": {
        "@html-report/core": "*"
      },
      "bin": {
        "html-report-create": "scripts/open-create.mjs",
        "html-report-grill": "scripts/html-grill.mjs",
        "html-report-install": "scripts/install-pwa.mjs",
        "html-report-scaffold": "scripts/scaffold-project.mjs",
        "html-report-serve": "scripts/server.mjs"
      },
      "engines": {
        "node": ">=18.0.0"
      }
    }
  }
}
