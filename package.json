{
  "name": "html-report",
  "version": "0.0.0-beta.1",
  "description": "Publication-grade, interactive, and print-ready HTML5 reports for AI coding agents.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./packages/core/scripts/harness.mjs",
  "bin": {
    "html-report": "./packages/core/scripts/harness.mjs",
    "html-report-build": "./packages/core/scripts/build-report.mjs",
    "html-report-scaffold": "./packages/studio/scripts/scaffold-project.mjs",
    "html-report-serve": "./packages/studio/scripts/server.mjs",
    "html-report-publish": "./packages/core/scripts/publish-report.mjs",
    "html-report-pwa": "./packages/core/scripts/generate-pwa.mjs",
    "html-report-install": "./packages/studio/scripts/install-pwa.mjs"
  },
  "exports": {
    ".": "./packages/core/scripts/harness.mjs",
    "./build": "./packages/core/scripts/build-report.mjs",
    "./scaffold": "./packages/studio/scripts/scaffold-project.mjs",
    "./harness": "./packages/core/scripts/harness.mjs",
    "./serve": "./packages/studio/scripts/server.mjs",
    "./publish": "./packages/core/scripts/publish-report.mjs",
    "./pwa": "./packages/core/scripts/pwa-builder.mjs",
    "./generate-pwa": "./packages/core/scripts/generate-pwa.mjs",
    "./theme": "./packages/core/scripts/theme-compiler.mjs",
    "./compatibility": "./packages/core/scripts/compatibility.mjs",
    "./caller-registry": "./packages/core/scripts/caller-registry.mjs",
    "./verify": "./packages/core/playwright/verify-report.mjs",
    "./authoring": "./packages/studio/scripts/authoring-plugin.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "HTML_REPORT_NO_OPEN=1 node --test packages/core/tests/*.test.mjs packages/studio/tests/*.test.mjs tests/integration/*.test.mjs",
    "test:e2e": "HTML_REPORT_NO_OPEN=1 node --test tests/e2e/*.test.mjs",
    "build": "node ./packages/core/scripts/build-report.mjs",
    "scaffold": "node ./packages/studio/scripts/scaffold-project.mjs",
    "serve": "node ./packages/studio/scripts/server.mjs",
    "install:wizard": "node ./packages/studio/scripts/install-pwa.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "html-report",
    "ai-agent",
    "semver",
    "antigravity",
    "claude-code",
    "reporting",
    "dashboard",
    "daisyui",
    "tailwind",
    "pwa"
  ],
  "author": "Dries Verb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DriesVerb/html-report.git"
  },
  "bugs": {
    "url": "https://github.com/DriesVerb/html-report/issues"
  },
  "homepage": "https://driesverb.github.io/html-report/"
}
